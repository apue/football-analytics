.DS_Store
.env
.env.*
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Independently cloned source data and reproducible derived data.
data/external/*
data/processed/*
!data/external/.gitkeep
!data/processed/.gitkeep

# Independently cloned teaching references. Only manifests and indexes are tracked.
references/external/*
!references/external/.gitkeep

# Generated report artifacts are opt-in for publication.
reports/generated/
